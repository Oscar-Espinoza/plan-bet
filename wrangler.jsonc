{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matchday",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": { "enabled": true },
  "vars": {
    "MATCHDAY_DATA_MODE": "live",
    "MATCHDAY_MAINTENANCE": "0",
    "PUBLIC_SITE_URL": "https://matchday.tendo.ar",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matchday-prod",
      "database_id": "f2f0f349-6479-4155-a5c6-d9b79e27af6a",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    { "binding": "PUBLIC", "id": "dee24d2bc7ae4ebb9169318918a5d0e9" },
  ],
  "services": [
    { "binding": "JOBS", "service": "matchday-jobs", "entrypoint": "Jobs" },
  ],
  "routes": [{ "pattern": "matchday.tendo.ar", "custom_domain": true }],
  "env": {
    "local": {
      "name": "matchday-local",
      "routes": [],
      "workers_dev": false,
      "vars": {
        "MATCHDAY_DATA_MODE": "live",
        "MATCHDAY_MAINTENANCE": "0",
        "PUBLIC_SITE_URL": "http://localhost:3000",
        "BETTER_AUTH_COOKIE_CACHE_VERSION": "production-d1",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matchday-prod",
          "database_id": "f2f0f349-6479-4155-a5c6-d9b79e27af6a",
          "migrations_dir": "drizzle",
          "remote": true,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "PUBLIC",
          "id": "dee24d2bc7ae4ebb9169318918a5d0e9",
          "remote": true,
        },
      ],
      "services": [],
    },
    "preview": {
      "name": "matchday-preview",
      "routes": [],
      "workers_dev": true,
      "vars": {
        "MATCHDAY_DATA_MODE": "live",
        "MATCHDAY_MAINTENANCE": "0",
        "PUBLIC_SITE_URL": "https://matchday-preview.jolyyjhon.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "matchday-preview",
          "database_id": "d5c258c4-491c-465e-834b-ab2aa0216924",
          "migrations_dir": "drizzle",
        },
      ],
      "kv_namespaces": [
        { "binding": "PUBLIC", "id": "8a316593b062493cacddfe7b89d63f2f" },
      ],
      "services": [
        {
          "binding": "JOBS",
          "service": "matchday-jobs-preview",
          "entrypoint": "Jobs",
        },
      ],
    },
  },
}
