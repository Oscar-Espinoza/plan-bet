# Server-only PostgreSQL connection string for the single Neon branch.
DATABASE_URL=

# Server-only token from football-data.org.
FOOTBALL_DATA_API_TOKEN=

# Optional deterministic local/E2E override. Leave unset in production.
MATCHDAY_DATA_MODE=

# Server-only OpenAI credential. Absent means briefings degrade to the
# deterministic fallback instead of failing.
OPENAI_API_KEY=

# Model used for briefing generation. Defaults to gpt-5.6-luna.
OPENAI_MODEL=

# Traceability stamps recorded on every briefing run.
BRIEFING_PROMPT_VERSION=
BRIEFING_SCHEMA_VERSION=

# Server-only salt for the anonymous IP quota hash. Raw IPs are never stored.
RATE_LIMIT_HASH_SECRET=

# Server-only shared secret for the scheduled refresh and settlement
# endpoints. Absent means they refuse to run. Generate with
# `openssl rand -hex 32` and set the same value in Vercel and in the
# PRODUCTION_URL/CRON_SECRET GitHub Actions secrets.
CRON_SECRET=

# Public site origin used for metadataBase and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000/

# Server-only Auth.js signing secret. Absent means sign-in is unavailable and
# the anonymous workspace runs exactly as before.
AUTH_SECRET=

# Canonical origin Auth.js builds callback URLs from. Unset is fine on Vercel.
AUTH_URL=

# Server-only GitHub OAuth app credentials. Absent means the provider is not offered.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Server-only Google OAuth client credentials. Absent means the provider is not offered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-only Resend credential and verified sender for group notifications
# (invites, group wager activity, settlement digests). Either one absent means
# email is a logged no-op — group wagers and settlement work exactly as before.
RESEND_API_KEY=
EMAIL_FROM=
