{
  "name": "matchday-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-database.ts",
    "test:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-usability-test.ts",
    "data:refresh:baseball": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/refresh-baseball.ts",
    "smoke:briefing": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/smoke-briefing.ts",
    "data:refresh:soccer": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/refresh-soccer.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.545.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "30.0.1",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
