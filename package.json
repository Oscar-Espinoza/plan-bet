{
  "name": "matchday-plan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "pnpm@11.22.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview:cf": "wrangler dev --env preview --port 8787",
    "deploy:preview": "pnpm build && wrangler deploy --env preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && node scripts/budget.mjs && node scripts/check-ok.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env preview",
    "migrate:export": "node --experimental-strip-types scripts/migrate/export-neon.ts",
    "migrate:transform": "node --experimental-strip-types scripts/migrate/transform.ts",
    "migrate:reconcile": "node --experimental-strip-types scripts/migrate/reconcile.ts",
    "verify:money": "node --experimental-strip-types scripts/verify/money-scenario.ts --base http://localhost:8787",
    "verify:groups": "node --experimental-strip-types scripts/verify/groups-scenario.ts --base http://localhost:8790",
    "verify:comments": "node --experimental-strip-types scripts/verify/comments-scenario.ts --base http://localhost:8780",
    "verify:settle": "tsx scripts/verify/settlement-scenario.ts",
    "verify:buddy": "node --experimental-strip-types scripts/verify/buddy-scenario.ts",
    "jobs:dev": "wrangler dev --config workers/jobs/wrangler.jsonc --env preview",
    "jobs:deploy:preview": "wrangler deploy --config workers/jobs/wrangler.jsonc --env preview"
  },
  "dependencies": {
    "@lucide/svelte": "^1.66.0",
    "better-auth": "1.7.5",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/js": "9.39.5",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "postgres": "4.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  }
}
