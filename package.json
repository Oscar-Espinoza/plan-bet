{
  "name": "matchday-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-database.ts",
    "test:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-usability-test.ts",
    "data:refresh:baseball": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/refresh-baseball.ts",
    "data:refresh:soccer": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/refresh-soccer.ts",
    "data:apisports:teams": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/apisports-teams.ts",
    "data:apisports:probe": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/apisports-probe.ts",
    "data:mcp:probe": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/mcp-probe.ts",
    "data:enrich": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/enrich.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.545.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
